---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getRecipeSlug } from '../../lib/recipes';
import SiteLayout from '../../layouts/SiteLayout.astro';
import RecipeMetadata from '../../components/RecipeMetadata.astro';
import ShareRecipe from '../../components/ShareRecipe.astro';
export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  const slugs = new Set<string>();
  return recipes.map((recipe) => {
    const slug = getRecipeSlug(recipe);
    if (slugs.has(slug)) throw new Error(`Duplicate recipe slug "${slug}". Recipe names must produce unique URLs.`);
    slugs.add(slug);
    return { params: { slug }, props: { recipe } };
  });
}
type Props = { recipe: CollectionEntry<'recipes'> };
const { recipe } = Astro.props;
const { Content } = await render(recipe);
if (!recipe.filePath) throw new Error(`Missing Markdown source for recipe "${recipe.id}".`);
const editUrl = `https://github.com/antoKeinanen/reseptim-me/edit/main/${recipe.filePath.split('/').map(encodeURIComponent).join('/')}`;
---
<SiteLayout title={recipe.data.name}>
  <div class="recipe-page">
    <article data-share-source>
      <header class="recipe-heading">
        <h1>{recipe.data.name}</h1>
        <RecipeMetadata data={recipe.data} />
        <div class="portion-note" data-portion-note data-share-exclude hidden>
          <button type="button" class="text-button" data-portion-reset>Palauta alkuperäinen ({recipe.data.portions.toLocaleString('fi-FI')})</button>
          <p id="portion-help">Valmistusohje ja hintatieto ovat alkuperäiselle annosmäärälle.</p>
        </div>
      </header>
      {recipe.data.images.length > 0 && (
        <div class="recipe-images" data-share-exclude>
          {recipe.data.images.map((image, index) => (
            <figure>
              <Image src={image.src} alt={image.alt} layout="constrained" width={1000} loading={index === 0 ? 'eager' : 'lazy'} />
              {image.caption && <figcaption>{image.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
      <div class="recipe-body"><Content /></div>
      <div class="recipe-actions" data-share-exclude>
        <ShareRecipe />
        <a class="share-button" href={editUrl} target="_blank" rel="noreferrer">Ehdota muutosta</a>
      </div>
    </article>
  </div>
</SiteLayout>
