---
import { getCollection } from 'astro:content';
import { getRecipeSlug } from '../lib/recipes';
import { categoryLabels, getDietLabel, formatRecipeCost, formatRecipeDate } from '../lib/recipe-labels';
import SiteLayout from '../layouts/SiteLayout.astro';
import RecipeMetadata from '../components/RecipeMetadata.astro';
const recipes = (await getCollection('recipes')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'fi'));
---
<SiteLayout>
  <h1 class="visually-hidden">Sitsireseptit ja annoslaskuri</h1>
  <div class="search-area">
    <label for="recipe-search" class="visually-hidden">Hae reseptejä</label>
    <div class="search-field">
      <svg viewBox="0 0 24 24" width="23" height="23" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <input id="recipe-search" type="search" placeholder="Hae reseptejä ja niiden tietoja" aria-describedby="search-help" />
      <button id="clear-search" class="clear-search" type="button" hidden aria-label="Tyhjennä haku">Tyhjennä</button>
    </div>
    <p id="search-help">Hae nimellä, tekijällä, ruokalajilla, annosmäärällä, ruokavaliolla, hinnalla tai päivämäärällä. Rajaa hakua yhdistämällä hakusanoja.</p>
  </div>
  <p id="recipe-count" class="visually-hidden" role="status">{recipes.length} {recipes.length === 1 ? 'resepti' : 'reseptiä'}</p>
  <div id="no-results" class="empty-results" hidden={recipes.length > 0}>
    <h2>{recipes.length ? 'Reseptejä ei löytynyt' : 'Ei reseptejä vielä'}</h2>
    <p>{recipes.length ? 'Kokeile vähemmän hakusanoja tai ruokalajia, kuten pääruoka.' : 'Uudet reseptit ilmestyvät tänne, kun ne lisätään.'}</p>
    <button id="reset-search" type="button" class="text-button" hidden={recipes.length === 0}>Näytä kaikki reseptit</button>
  </div>
  <ul class="recipe-grid">
    {recipes.map((recipe) => {
      const { name, author, category, portions, diet, cost, dateOfCost } = recipe.data;
      const metadata = [name, author, category, categoryLabels[category], portions, portions.toLocaleString('fi-FI'), ...diet, ...diet.map(getDietLabel), cost, cost === null ? '' : formatRecipeCost(cost), dateOfCost, dateOfCost ? formatRecipeDate(dateOfCost) : ''].join(' ');
      return <li data-recipe-search={metadata}>
        <a class="recipe-card" href={`/recipes/${getRecipeSlug(recipe)}/`}>
          <h2>{name}</h2>
          <RecipeMetadata data={recipe.data} compact />
        </a>
      </li>;
    })}
  </ul>
</SiteLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('#recipe-search');
  const count = document.querySelector<HTMLElement>('#recipe-count');
  const noResults = document.querySelector<HTMLElement>('#no-results');
  const clear = document.querySelector<HTMLButtonElement>('#clear-search');
  const reset = document.querySelector<HTMLButtonElement>('#reset-search');
  function normalizeSearch(value: string): string {
    return value.normalize('NFKD').replace(/\p{M}/gu, '').toLowerCase();
  }
  const recipes = Array.from(document.querySelectorAll<HTMLLIElement>('[data-recipe-search]'), (item) => ({ item, metadata: normalizeSearch(item.dataset.recipeSearch ?? '') }));
  if (search && count && noResults && clear && reset) {
    const update = () => {
      const terms = normalizeSearch(search.value).trim().split(/\s+/).filter(Boolean);
      let matches = 0;
      for (const recipe of recipes) {
        const matched = terms.every((term) => recipe.metadata.includes(term));
        recipe.item.hidden = !matched;
        if (matched) matches += 1;
      }
      count.textContent = `${matches} ${matches === 1 ? 'resepti' : 'reseptiä'}`;
      noResults.hidden = matches > 0;
      clear.hidden = search.value.length === 0;
    };
    const clearSearch = () => { search.value = ''; update(); search.focus(); };
    search.addEventListener('input', update);
    clear.addEventListener('click', clearSearch);
    reset.addEventListener('click', clearSearch);
    update();
  }
</script>
