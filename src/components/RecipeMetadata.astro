---
import type { CollectionEntry } from 'astro:content';
import { categoryLabels, getDietLabel, formatRecipeCost, formatRecipeDate } from '../lib/recipe-labels';
type Props = { data: CollectionEntry<'recipes'>['data']; compact?: boolean };
const { data, compact = false } = Astro.props;
const { author, category, portions, diet, cost, dateOfCost } = data;
const categoryLabel = categoryLabels[category];
---
<dl class:list={['recipe-metadata', { 'metadata-compact': compact }]}>
  <div class="metadata-category"><dt>Ruokalaji</dt><dd>{categoryLabel}</dd></div>
  <div class="metadata-portions"><dt>Annoksia</dt><dd>{portions.toLocaleString('fi-FI')}{compact && ` ${portions === 1 ? 'annos' : 'annosta'}`}</dd></div>
  <div class="metadata-diet"><dt>Ruokavalio</dt><dd>{diet.length ? diet.map(getDietLabel).join(', ') : 'Ei ruokavaliotietoja'}</dd></div>
  {!compact && <div class="metadata-author"><dt>Reseptin tekijä</dt><dd>{author || 'Ei tiedossa'}</dd></div>}
</dl>
{!compact && <dl class="recipe-metadata metadata-pricing">
  <div class="metadata-cost"><dt>Hinta</dt><dd>{cost === null ? 'Ei tiedossa' : formatRecipeCost(cost)}</dd></div>
  <div class="metadata-date"><dt>Hinnan päiväys</dt><dd>{dateOfCost ? <time datetime={dateOfCost}>{formatRecipeDate(dateOfCost)}</time> : 'Ei tiedossa'}</dd></div>
</dl>}
