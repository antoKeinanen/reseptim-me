---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import logo from '../../public/logo.png';
type Props = {
  title?: string;
  description?: string;
  image?: { src: string; width: number; height: number; alt: string };
};
const {
  title = 'Sitsireseptit ja annoslaskuri',
  description = 'Reseptejä sitsien eli akateemisten pöytäjuhlien tarjoiluihin. Etsi ruokalajiin ja ruokavalioon sopivat sitsireseptit ja skaalaa ainesmäärät vierasmäärän mukaan.',
  image,
} = Astro.props;
const pageTitle = `${title} | reseptim.me`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const fallbackImage = await getImage({ src: logo, width: 1200, format: 'png' });
const previewImage = image ?? { src: fallbackImage.src, width: Number(fallbackImage.attributes.width), height: Number(fallbackImage.attributes.height), alt: 'reseptim.me, Eva Långbackan suunnittelema kattilalogo' };
const imageUrl = new URL(previewImage.src, Astro.site);
---
<!doctype html>
<html lang="fi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="reseptim.me" />
    <meta property="og:locale" content="fi_FI" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={"" + previewImage.width} />
    <meta property="og:image:height" content={"" + previewImage.height} />
    <meta property="og:image:alt" content={previewImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={previewImage.alt} />
  </head>
  <body>
    <a class="skip-link" href="#main">Siirry sisältöön</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="reseptim.me, etusivu">
          <img src="/logo.png" alt="reseptim.me" width="102" height="72" />
          <span>reseptim.me</span>
        </a>
        <nav class="site-nav" aria-label="Lisäsivut">
          <a href="/tips/">Vinkit</a>
          <a href="/terms/">Sanastoa</a>
          <a href="/about/">Tietoa sivustosta</a>
        </nav>
      </header>
      <main id="main"><slot /></main>
    </div>
  </body>
</html>
